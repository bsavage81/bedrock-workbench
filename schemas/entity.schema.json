{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock entity — foundational validation",
  "type": "object",
  "required": [
    "format_version",
    "minecraft:entity"
  ],
  "properties": {
    "format_version": {
      "type": "string"
    },
    "minecraft:entity": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "object",
          "required": [
            "identifier"
          ],
          "properties": {
            "identifier": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            "is_spawnable": {
              "type": "boolean"
            },
            "is_summonable": {
              "type": "boolean"
            },
            "is_experimental": {
              "type": "boolean"
            }
          }
        },
        "components": {
          "type": "object",
          "properties": {
            "minecraft:health": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              }
            },
            "minecraft:type_family": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "minecraft:movement": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          }
        },
        "component_groups": {
          "type": "object"
        },
        "events": {
          "type": "object"
        },
        "permutations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string"
              },
              "components": {
                "type": "object",
                "properties": {
                  "minecraft:health": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    }
                  },
                  "minecraft:type_family": {
                    "type": "object",
                    "properties": {
                      "family": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "minecraft:movement": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
