{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock Workbench sound definitions",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "string",
      "description": "Sound-definition format version."
    },
    "sound_definitions": {
      "type": "object",
      "description": "Maps sound event identifiers to audio definitions.",
      "additionalProperties": {
        "$ref": "#/definitions/soundEvent"
      }
    }
  },
  "required": [
    "sound_definitions"
  ],
  "definitions": {
    "soundFile": {
      "anyOf": [
        {
          "type": "string",
          "description": "Sound file path, usually without an extension."
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Sound file path."
            },
            "volume": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            },
            "weight": {
              "type": "number"
            },
            "stream": {
              "type": "boolean",
              "description": "Stream this audio instead of loading it all at once."
            },
            "load_on_low_memory": {
              "type": "boolean"
            },
            "is3D": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ]
        }
      ]
    },
    "soundEvent": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "Sound mixer category. Kept open for supported engine categories."
        },
        "sounds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/soundFile"
          },
          "description": "Candidate audio files, as paths or objects with playback settings."
        },
        "min_distance": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_distance": {
          "type": [
            "number",
            "null"
          ]
        },
        "use_legacy_max_distance": {
          "type": "boolean"
        },
        "__use_legacy_max_distance": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Legacy compatibility setting; published packs also use string values."
        }
      }
    }
  }
}
