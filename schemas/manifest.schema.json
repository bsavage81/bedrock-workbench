{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock pack manifest (format 2)",
  "type": "object",
  "required": [
    "format_version",
    "header",
    "modules"
  ],
  "properties": {
    "format_version": {
      "const": 2
    },
    "header": {
      "type": "object",
      "required": [
        "name",
        "description",
        "uuid",
        "version",
        "min_engine_version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "version": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Explicit major, minor, patch. Never increments on save."
        },
        "min_engine_version": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Explicit major, minor, patch. Never increments on save."
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "uuid",
          "version"
        ],
        "properties": {
          "type": {
            "enum": [
              "data",
              "resources",
              "script",
              "world_template",
              "skin_pack"
            ]
          },
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "version": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Explicit major, minor, patch. Never increments on save."
          },
          "language": {
            "const": "javascript"
          },
          "entry": {
            "type": "string",
            "description": "Compiled script entry, e.g. scripts/main.js"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "module_name": {
            "type": "string",
            "examples": [
              "@minecraft/server",
              "@minecraft/server-ui"
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "Explicit major, minor, patch. Never increments on save."
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "uuid",
              "version"
            ]
          },
          {
            "required": [
              "module_name",
              "version"
            ]
          }
        ]
      }
    },
    "metadata": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
