    "lootCondition": {
      "type": "object",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "random_chance",
                "random_chance_with_looting",
                "random_difficulty_chance",
                "random_regional_difficulty_chance",
                "killed_by_player",
                "killed_by_player_or_pets",
                "killed_by_entity",
                "damaged_by_entity",
                "entity_killed",
                "passenger_of_entity",
                "is_baby",
                "has_variant",
                "has_mark_variant",
                "bool_property",
                "biome_has_tag",
                "entity_properties",
                "match_tool"
              ]
            },
            {
              "type": "string",
              "description": "Condition identifier; additional engine conditions remain allowed."
            }
          ],
          "description": "Requirement to test before selecting loot."
        }
      },
      "required": [
