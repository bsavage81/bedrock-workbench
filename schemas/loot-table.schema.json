{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock Workbench loot table",
  "type": "object",
  "properties": {
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rolls": {
            "$ref": "#/definitions/range"
          },
          "bonus_rolls": {
            "$ref": "#/definitions/range"
          },
          "conditions": {
            "type": "array",
            "description": "Requirements for this pool, entry, or function. Choose a condition starter.",
            "items": {
              "$ref": "#/definitions/lootCondition"
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Entry kind, such as item, loot_table, or empty."
                },
                "name": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                },
                "quality": {
                  "type": "number"
                },
                "functions": {
                  "type": "array",
                  "description": "Item modifiers. Add a function object or choose a starter.",
                  "items": {
                    "$ref": "#/definitions/lootFunction"
                  }
                },
                "conditions": {
                  "type": "array",
                  "description": "Requirements for this pool, entry, or function. Choose a condition starter.",
                  "items": {
                    "$ref": "#/definitions/lootCondition"
                  }
                }
              }
            }
          },
          "functions": {
            "type": "array",
            "description": "Item modifiers. Add a function object or choose a starter.",
            "items": {
              "$ref": "#/definitions/lootFunction"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "range": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    },
    "lootFunction": {
      "type": "object",
      "properties": {
        "function": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "set_count",
                "set_damage",
                "set_data",
                "enchant_randomly",
                "enchant_with_levels",
                "enchant_random_gear",
                "specific_enchants",
                "looting_enchant",
                "furnace_smelt",
                "explosion_decay",
                "set_actor_id",
                "set_data_from_color_index",
                "set_name",
                "set_lore",
                "set_potion",
                "set_book_contents",
                "set_banner_details",
                "set_armor_trim",
                "set_stew_effect",
                "set_ominous_bottle_amplifier",
                "random_aux_value",
                "random_block_state",
                "exploration_map",
                "fill_container",
                "minecraft:set_count",
                "minecraft:set_damage",
                "minecraft:enchant_randomly",
                "minecraft:set_stew_effect",
                "minecraft:set_potion",
                "minecraft:set_data_from_color_index"
              ]
            },
            {
              "type": "string",
              "description": "Function identifier; additional engine functions remain allowed."
            }
          ],
          "description": "Loot modifier to apply to this item."
        },
        "conditions": {
          "type": "array",
          "description": "Requirements for this pool, entry, or function. Choose a condition starter.",
          "items": {
            "$ref": "#/definitions/lootCondition"
          }
        }
      },
      "required": [
        "function"
      ],
      "defaultSnippets": [
        {
          "label": "set_count",
          "description": "Choose the stack size.",
          "body": {
            "function": "set_count",
            "count": 1
          }
        },
        {
          "label": "set_damage",
          "description": "Choose remaining item durability.",
          "body": {
            "function": "set_damage",
            "damage": {
              "min": 0.5,
              "max": 1
            }
          }
        },
        {
          "label": "set_data",
          "description": "Choose legacy item data.",
          "body": {
            "function": "set_data",
            "data": 0
          }
        },
        {
          "label": "enchant_randomly",
          "description": "Choose a compatible random enchantment.",
          "body": {
            "function": "enchant_randomly",
            "treasure": false
          }
        },
        {
          "label": "enchant_with_levels",
          "description": "Enchant using an experience level.",
          "body": {
            "function": "enchant_with_levels",
            "levels": 30,
            "treasure": false
          }
        },
        {
          "label": "enchant_random_gear",
          "description": "Apply mob-equipment enchantment rules.",
          "body": {
            "function": "enchant_random_gear",
            "chance": 0.25
          }
        },
        {
          "label": "specific_enchants",
          "description": "Choose explicit enchantments.",
          "body": {
            "function": "specific_enchants",
            "enchants": [
              {
                "id": "sharpness",
                "level": 1
              }
            ]
          }
        },
        {
          "label": "looting_enchant",
          "description": "Adjust drops for Looting.",
          "body": {
            "function": "looting_enchant",
            "count": {
              "min": 0,
              "max": 1
            }
          }
        },
        {
          "label": "furnace_smelt",
          "description": "Use the cooked item variant.",
          "body": {
            "function": "furnace_smelt"
          }
        },
        {
          "label": "explosion_decay",
          "description": "Reduce drops after an explosion.",
          "body": {
            "function": "explosion_decay"
          }
        },
        {
          "label": "set_actor_id",
          "description": "Choose a spawn-egg entity.",
          "body": {
            "function": "set_actor_id",
            "id": "minecraft:pig"
          }
        },
        {
          "label": "set_data_from_color_index",
