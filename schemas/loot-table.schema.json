        },
        {
          "label": "set_ominous_bottle_amplifier",
          "description": "Choose the Bad Omen amplifier.",
          "body": {
            "function": "set_ominous_bottle_amplifier",
            "amplifier": {
              "min": 0,
              "max": 3
            }
          }
        },
        {
          "label": "random_aux_value",
