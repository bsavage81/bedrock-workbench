{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock Workbench authoring update manifest v1",
  "type": "object",
  "required": ["dataFormatVersion", "channel", "generatedAt", "snapshots"],
  "additionalProperties": false,
  "properties": {
    "dataFormatVersion": { "const": 1 },
    "channel": { "enum": ["stable", "preview"] },
    "generatedAt": { "type": "string" },
    "snapshots": { "type": "array", "maxItems": 300, "items": { "$ref": "#/definitions/snapshot" } }
  },
  "definitions": {
    "range": {
      "type": "object", "required": ["min", "max"], "additionalProperties": false,
      "properties": { "min": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "max": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["dataFormatVersion", "id", "channel", "generatedAt", "extension", "minecraft", "sources", "url", "sha256", "bytes"],
      "properties": {
        "dataFormatVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$" },
        "channel": { "enum": ["stable", "preview"] },
        "generatedAt": { "type": "string" },
        "extension": { "$ref": "#/definitions/range" }, "minecraft": { "$ref": "#/definitions/range" },
        "url": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "reviewFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 25165824 },
        "sources": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["url", "revision", "license", "attribution"], "properties": {
            "url": { "type": "string" }, "revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
            "license": { "type": "string" }, "attribution": { "type": "string" }, "tag": { "type": "string" }, "channel": { "enum": ["stable", "preview"] }, "available": { "type": "boolean" }
          }, "additionalProperties": false }
        }
      }
    }
  }
}
