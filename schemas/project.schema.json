{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock Workbench Project",
  "type": "object",
  "required": [
    "formatVersion",
    "name",
    "version",
    "target",
    "targetVersion",
    "packs",
    "build",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Explicit major, minor, patch. Never increments on save."
    },
    "target": {
      "enum": [
        "release",
        "preview"
      ],
      "description": "Minecraft installation to deploy beta builds to."
    },
    "targetVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Minimum engine version, independent of pack version."
    },
    "experimentalGameplay": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "World experiment requirements. betaApis also selects beta Script API dependencies and typings. Other flags document the world setup required by this project.",
      "properties": {
        "betaApis": {
          "type": "boolean",
          "default": false,
          "description": "Select beta Script API dependencies and typings. Enable Beta APIs in the Minecraft world too. Project requirement only; enable in Minecraft world settings."
        },
        "upcomingCreatorFeatures": {
          "type": "boolean",
          "default": false,
          "description": "Upcoming add-on features and component capabilities. Project requirement only; enable in Minecraft world settings."
        },
        "creatorCameras": {
          "type": "boolean",
          "default": false,
          "description": "Experimental custom camera features. Project requirement only; enable in Minecraft world settings."
        },
        "villagerTradeRebalancing": {
          "type": "boolean",
          "default": false,
          "description": "Experimental villager trades. Project requirement only; enable in Minecraft world settings."
        },
        "voxelShapes": {
          "type": "boolean",
          "default": false,
          "description": "Experimental voxel shapes for vanilla and custom blocks. Project requirement only; enable in Minecraft world settings."
        },
        "worldClocks": {
          "type": "boolean",
          "default": false,
          "description": "Experimental creator world clocks. Project requirement only; enable in Minecraft world settings."
        },
        "pointsOfInterest": {
          "type": "boolean",
          "default": false,
          "description": "Custom points of interest for locate and scripting. Project requirement only; enable in Minecraft world settings."
        },
        "renderDragon": {
          "type": "boolean",
          "default": false,
          "description": "Experimental rendering features; compatible hardware and resource packs required. Project requirement only; enable in Minecraft world settings."
        },
        "netherSpawning": {
          "type": "boolean",
          "default": false,
          "description": "Experimental Nether mob spawning balance. Project requirement only; enable in Minecraft world settings."
        },
        "drop4of2026": {
          "type": "boolean",
          "default": false,
          "description": "Upcoming gameplay features for the fourth 2026 drop. Project requirement only; enable in Minecraft world settings."
        },
        "customBiomes": {
          "type": "boolean",
          "default": false,
          "description": "Legacy custom biome experiment. Project requirement only; enable in Minecraft world settings."
        },
        "jigsawStructures": {
          "type": "boolean",
          "default": false,
          "description": "Legacy data-driven jigsaw structure experiment. Project requirement only; enable in Minecraft world settings."
        },
        "customComponentsV2": {
          "type": "boolean",
          "default": false,
          "description": "Legacy custom component experiment; no longer needed by modern targets. Project requirement only; enable in Minecraft world settings."
        }
      }
    },
    "packs": {
      "type": "object",
      "required": [
        "behavior",
        "resource"
      ],
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoDeploy",
        "output",
        "exports"
      ],
      "properties": {
        "autoDeploy": {
          "type": "boolean",
          "default": false
        },
        "output": {
          "type": "string",
          "pattern": "^\\.bedrock/"
        },
        "exports": {
          "type": "string",
          "pattern": "^\\.bedrock/"
        },
        "destinations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "release": {
              "type": "string"
            },
            "preview": {
              "type": "string"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": [
        "beta",
        "stable"
      ],
      "additionalProperties": false,
      "properties": {
        "beta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "identities"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "identities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "behavior",
                "resource"
              ],
              "properties": {
                "behavior": {
                  "type": "object",
                  "required": [
                    "header",
                    "modules"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "header": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "modules": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      }
                    }
                  }
                },
                "resource": {
                  "type": "object",
                  "required": [
                    "header",
                    "modules"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "header": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "modules": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "stable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "identities"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "identities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "behavior",
                "resource"
              ],
              "properties": {
                "behavior": {
                  "type": "object",
                  "required": [
                    "header",
                    "modules"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "header": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "modules": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      }
                    }
                  }
                },
                "resource": {
                  "type": "object",
                  "required": [
                    "header",
                    "modules"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "header": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "modules": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project validation preferences. Intended-reference rules suppress only unresolved reference findings, not schema or syntax errors.",
      "properties": {
        "ignoredReferences": {
          "type": "array",
          "description": "Explicit references intentionally supplied elsewhere. Remove a rule to check that reference again.",
          "items": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z_]+$",
                "description": "Reference kind, such as texture, item, block, or geometry."
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Exact reference text to ignore."
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "description": "Optional project-relative file path using forward slashes. Omit to apply throughout the project."
              },
              "reason": {
                "type": "string",
                "description": "Optional explanation for accepting this reference."
              }
            }
          }
        }
      }
    }
  }
}
