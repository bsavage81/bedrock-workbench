          "description": "Recipe-book discovery conditions; a context object or an ingredient/context array. Availability depends on format version."
        },
        "input": {
          "$ref": "#/definitions/ingredient"
        },
        "output": {
          "$ref": "#/definitions/result"
        }
      },
      "required": [
        "description",
        "input",
        "output"
      ],
      "description": "Workbench structural validation for furnace recipes. Unknown extension fields are allowed."
    },
