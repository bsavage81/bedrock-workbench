  "required": [
    "format_version"
  ],
  "patternProperties": {
    "^minecraft:recipe_": {
      "type": "object"
    }
  },
  "definitions": {
    "ingredient": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "description": "Input item identifier."
            },
            "tag": {
              "type": "string",
              "description": "An item tag matching eligible ingredients."
            },
            "data": {
              "type": "integer",
              "description": "Legacy auxiliary value."
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "item"
              ]
            },
            {
              "required": [
                "tag"
              ]
            }
          ]
        },
        {
          "type": "string",
          "description": "Item identifier, including a legacy auxiliary suffix where supported."
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "description": "Output item identifier."
            },
            "data": {
              "type": "integer"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "item"
          ]
        },
        {
          "type": "string",
          "description": "Output item identifier."
        }
      ]
    },
    "unlock": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "data": {
          "type": "integer"
        },
        "context": {
          "type": "string",
          "description": "Recipe discovery context, such as AlwaysUnlocked."
        }
      }
    },
    "results": {
      "anyOf": [
        {
          "$ref": "#/definitions/result"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/result"
          },
          "minItems": 1
        }
      ]
    }
  }
}
