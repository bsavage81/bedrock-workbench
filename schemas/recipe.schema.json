        "tags": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "crafting_table",
                  "stonecutter",
                  "cartography_table"
                ]
              },
              {
                "type": "string",
                "description": "Custom recipe station tag."
              }
            ]
          },
          "description": "Stations that can use this recipe, such as crafting_table, stonecutter, or furnace."
        },
        "priority": {
          "type": "integer",
          "description": "Smaller values take precedence among competing recipes."
        },
        "unlock": {
          "anyOf": [
            {
              "$ref": "#/definitions/unlock"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/unlock"
              }
            }
          ],
          "description": "Recipe-book discovery conditions; a context object or an ingredient/context array. Availability depends on format version."
        },
        "ingredients": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ingredient"
          },
          "minItems": 1,
          "description": "Ingredients accepted in any arrangement."
        },
        "result": {
          "$ref": "#/definitions/results"
        }
      },
      "required": [
        "description",
        "ingredients",
        "result"
      ],
      "description": "Workbench structural validation for shapeless recipes. Unknown extension fields are allowed."
    },
    "minecraft:recipe_furnace": {
      "type": "object",
      "properties": {
        "description": {
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string",
