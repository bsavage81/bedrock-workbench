{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock Workbench recipe",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "string",
      "description": "Recipe format version; older two-part versions remain valid."
    },
    "minecraft:recipe_shaped": {
      "type": "object",
      "properties": {
        "description": {
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string",
              "description": "Unique recipe identifier."
            }
          },
          "required": [
            "identifier"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "crafting_table"
                ]
              },
              {
                "type": "string",
                "description": "Custom recipe station tag."
              }
            ]
          },
          "description": "Stations that can use this recipe, such as crafting_table, stonecutter, or furnace."
        },
        "priority": {
          "type": "integer",
          "description": "Smaller values take precedence among competing recipes."
        },
        "unlock": {
          "anyOf": [
            {
              "$ref": "#/definitions/unlock"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/unlock"
              }
            }
          ],
          "description": "Recipe-book discovery conditions; a context object or an ingredient/context array. Availability depends on format version."
        },
        "pattern": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3
          },
          "minItems": 1,
          "maxItems": 3,
          "description": "Crafting rows. Spaces leave slots empty; other characters refer to key."
        },
        "key": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 1,
            "pattern": "^[^ ]$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/ingredient"
          },
          "description": "Maps each non-space pattern symbol to an ingredient."
        },
        "result": {
          "$ref": "#/definitions/results"
        },
        "assume_symmetry": {
          "type": "boolean",
          "description": "Allow mirrored patterns to use this recipe."
        }
      },
      "required": [
        "description",
        "pattern",
        "key",
        "result"
      ],
      "description": "Workbench structural validation for shaped recipes. Unknown extension fields are allowed."
    },
    "minecraft:recipe_shapeless": {
